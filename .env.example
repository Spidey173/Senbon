# ==============================================================================
# Senbon — Retail Intelligence & Analytics Engine - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# MinIO / S3 Lakehouse Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_DOCKER_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_RAW=retail-raw
MINIO_BUCKET_BRONZE=retail-bronze
MINIO_BUCKET_SILVER=retail-silver
MINIO_BUCKET_GOLD=retail-gold
MINIO_BUCKET_QUARANTINE=retail-quarantine

# PostgreSQL Data Warehouse & Airflow Metadata
POSTGRES_HOST=localhost
POSTGRES_DOCKER_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=retail_admin
POSTGRES_PASSWORD=retail_secure_pass_2026
POSTGRES_DB=retail_dw
AIRFLOW_DB=airflow

# Apache Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=data-eng@retail-corp.internal
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqnzq8=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Retail Mock APIs
MOCK_API_HOST=0.0.0.0
MOCK_API_PORT=8000
MOCK_API_URL=http://localhost:8000
MOCK_API_DOCKER_URL=http://retail-mock-api:8000

# Lakehouse Engine (DuckDB)
DUCKDB_DATABASE_PATH=./data/retail_lakehouse.duckdb

# dbt Project Paths
DBT_PROFILES_DIR=./dbt
DBT_PROJECT_DIR=./dbt

# Alerting & Dead Letter Queue (Optional Webhook Integration)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/mock/alert/channel
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2

